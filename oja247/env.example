# --- Google Sign-In (login only, no signup) ---
# From Google Cloud Console > APIs & Services > Credentials > OAuth client
# ID (Web application). Public value, safe to expose in frontend code —
# it identifies the app, it isn't a secret. Must match the backend's
# GOOGLE_CLIENT_ID (see backend/env.example).
VITE_GOOGLE_CLIENT_ID=

# From Paystack Dashboard > Settings > API Keys & Webhooks.
# Public key is safe for frontend use; do not put the secret key here.
VITE_PAYSTACK_PUBLIC_KEY=
