# --- Existing ---
MONGO_URI=
JWT_SECRET=
NODE_ENV=production
PAYSTACK_SECRET_KEY=
PLATFORM_PERCENTAGE_CHARGE=10
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CRON_SECRET=

# --- Transactional email (Zoho Mail SMTP) ---
# ZOHO_SMTP_USER is the full mailbox address, e.g. support@oja247.store
# ZOHO_SMTP_PASS is a Zoho "app password", NOT the regular mailbox login
# password. Generate one at: mail.zoho.com > Settings > Security >
# App Passwords. Required if you have 2FA on; safer either way since it
# can be revoked independently of your main password.
ZOHO_SMTP_USER=support@oja247.store
ZOHO_SMTP_PASS=
# Optional — these already default to Zoho's standard SMTP settings:
# ZOHO_SMTP_HOST=smtp.zoho.com
# ZOHO_SMTP_PORT=465
# EMAIL_FROM_NAME=OJA247 STORE
# LOGO_URL=https://oja247.store/favicon.png   (shown in every email header)
# SITE_URL=https://oja247.store               (used for buttons/links in emails)

# --- Google Sign-In (login only, no signup) ---
# From Google Cloud Console > APIs & Services > Credentials > OAuth client
# ID (Web application). Must match the same Client ID used in the
# frontend's VITE_GOOGLE_CLIENT_ID — used server-side to verify the ID
# token's audience, so a token meant for a different app can't be replayed
# here.
GOOGLE_CLIENT_ID=


# --- NIN verification (Dojah) ---
# From Dojah dashboard > Developers > Configuration > My Apps. If these two are
# left empty the NIN check is skipped and onboarding works as before.
# While testing use the sandbox (free, only knows test NIN 70123456789):
#   DOJAH_BASE_URL=https://sandbox.dojah.io
# Leave DOJAH_BASE_URL unset in production (defaults to https://api.dojah.io,
# billed per lookup from your Dojah wallet). Sandbox keys do NOT work on live.
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
# DOJAH_BASE_URL=https://sandbox.dojah.io

# --- Email: orders, announcements ---------------------------------------
# Order delivery: days after "sent out" before the customer gets a reminder,
# and before the order is marked received automatically.
# RECEIPT_REMINDER_DAYS=3
# AUTO_RECEIVE_DAYS=7
# Admin announcements are sent a few at a time through the same Zoho mailbox
# that sends order emails. Set the cap to comfortably under your Zoho plan's
# real daily sending limit (a campaign pauses at the cap and continues next day).
# EMAIL_DAILY_CAP=100
# EMAIL_BATCH_SIZE=5
