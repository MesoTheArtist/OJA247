{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "crons": [
    {
      "path": "/api/cron/payout-batch",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/cron/subscription-expiry",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/dispute-escalation",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/verification-reminder",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/auto-receive",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/transfer-follow-up",
      "schedule": "0 11 * * *"
    }
  ]
}